# Multi-tenant Firebase service accounts
FIREBASE_0XOLEMON_CREDENTIALS_JSON={"type":"service_account","project_id":"xolemon-b360e","private_key":"...","client_email":"..."}
FIREBASE_0XOLEMON1_CREDENTIALS_JSON={"type":"service_account","project_id":"xolemon-1","private_key":"...","client_email":"..."}

# Server
PORT=8080

# Offline activation security. Generate independent random values; never commit real values.
ACTIVATION_ENCRYPTION_KEY=base64-encoded-32-byte-key
ACTIVATION_ADMIN_KEY=long-random-admin-key
ACTIVATION_TENANT_ID=0xolemon
ACTIVATION_MIN_LAUNCHER_VERSION=2.0.42

# Discord authorization
DISCORD_REQUIRED_GUILD_ID=1492076309323714570
DISCORD_ALLOWED_ROLE_IDS=role-id-1,role-id-2
DISCORD_MINIMUM_ACCOUNT_AGE_DAYS=7

# Web Discord OAuth + Remote Web Access. Generate independent 32-byte secrets.
WEB_AUTH_ENABLED=false
REMOTE_WEB_ENABLED=false
REMOTE_CANARY_DISCORD_IDS=discord-id-for-test-account
PUBLIC_WEB_URL=https://0xo-lemon-launcher.vercel.app
PUBLIC_BASE_URL=https://zeroxolemon-launcher.onrender.com
WEB_ALLOWED_ORIGINS=https://0xo-lemon-launcher.vercel.app
DISCORD_CLIENT_ID=discord-oauth-application-id
DISCORD_CLIENT_SECRET=set-in-render-secret-environment
DISCORD_WEB_REDIRECT_URI=https://0xo-lemon-launcher.vercel.app/api/0xolemon/auth/discord/callback
WEB_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
REMOTE_ACCOUNT_HMAC_KEY=independent-random-key-at-least-32-characters
LEGAL_TERMS_VERSION=2026-08-25
LEGAL_PRIVACY_VERSION=2026-08-25

# Lua Shop community cache. Keep both values in Render secrets.
LUA_SHOP_ACCOUNT_HMAC_KEY=independent-random-key-at-least-32-characters
HF_LUA_COMMUNITY_WRITE_TOKEN=hugging-face-write-token
HF_LUA_COMMUNITY_REPO=Immaking/Luas
HF_LUA_COMMUNITY_BRANCH=main

# Optional Steam Web API key used only by Render for full-catalog browsing.
# Name/AppID search continues to use the public Steam Store endpoint without this key.
STEAM_WEB_API_KEY=steam-web-api-key

# Social canary. Keep secrets in Render; never put real values in this file.
SOCIAL_ENABLED=true
SOCIAL_CANARY_MODE=true
SOCIAL_CANARY_DISCORD_IDS=discord-id-for-test-account
SOCIAL_ACCOUNT_HMAC_KEY=independent-random-key-at-least-32-characters
HF_SOCIAL_MEDIA_TOKEN=fine-grained-write-token-for-PROBBI-PROBBINE-only
HF_SOCIAL_MEDIA_REPO=PROBBI/PROBBINE
HF_SOCIAL_MEDIA_BRANCH=main
SOCIAL_COVER_BATCH_SECONDS=600

# EA service identity
EA_CLIENT_ID=JUNO_PC_CLIENT
EA_CLIENT_SECRET=set-in-render-secret-environment
EA_MACHINE_HASH=set-in-render-secret-environment
EA_REFRESH_TOKEN_BOOTSTRAP=set-once-in-render-secret-environment

# Signed activation package metadata. Every extracted file must be listed here.
ACTIVATION_PACKAGE_VERSION=1
ACTIVATION_PACKAGE_URL=https://example.invalid/FC.26.NOTACRACK.7z
ACTIVATION_PACKAGE_SIZE_BYTES=123456
ACTIVATION_PACKAGE_SHA256=64-lowercase-hex-characters
ACTIVATION_PACKAGE_PASSWORD=set-in-render-secret-environment
ACTIVATION_PACKAGE_FILES_JSON=[{"path":"anadius.cfg","sha256":"64-lowercase-hex-characters","sizeBytes":123}]
